# ─── Database ──────────────────────────────────────────────────────────────────
# NOTE: Start scripts set NODE_OPTIONS=--dns-result-order=ipv4first to force IPv4
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safecrib_dev?schema=public&connection_limit=20"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/safecrib_dev?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Redis server policy must be configured as noeviction. This flag enables the
# startup check/repair when the Redis provider permits CONFIG SET.
REDIS_ENFORCE_NOEVICTION=true

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Mail (Brevo Transactional Email API) ───────────────────────────────────────
# Create an API key in Brevo and verify this sender/domain in Brevo before use.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=SafeCrib
# Optional: leave unchanged unless Brevo provides a different endpoint.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# ─── App ────────────────────────────────────────────────────────────────────────
PORT=3001
ENABLE_SWAGGER=true
API_NAME=SafeCrib API
API_DESCRIPTION=SafeCrib Platform API Documentation
API_VERSION=1.0.0

# ─── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL_TESTING=http://localhost:3000
FRONTEND_URL_PRODUCTION=
FRONTEND_URL_SWAGGER=http://localhost:3001

# ─── CORS (optional, comma-separated additional origins) ───────────────────────
CORS_ORIGINS=

# ─── Throttler ──────────────────────────────────────────────────────────────────
# TTL is in seconds. The value is converted to milliseconds internally.
THROTTLE_TTL=60            # default window for general API requests (seconds)
THROTTLE_LIMIT=10          # max requests per TTL window for general API
THROTTLE_AUTH_TTL=60       # window for auth endpoints (login, refresh, logout) (seconds)
THROTTLE_AUTH_LIMIT=10     # max auth requests per window per IP
THROTTLE_STRICT_TTL=3600   # window for sensitive endpoints (register, forgot-password) (seconds)
THROTTLE_STRICT_LIMIT=3    # max requests per window per IP for sensitive endpoints

# ─── Cloudinary (Media System) ──────────────────────────────────────────────────
# Your Cloudinary account credentials (Settings → Access Keys)
CLOUDINARY_CLOUD_NAME=u1dad45h
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public URL this API is reachable at — Cloudinary will POST webhooks here
CLOUDINARY_WEBHOOK_URL=https://your-api.example.com/api/v1/media/webhook
# Prefix that namespaces all media in Cloudinary (dev / staging / prod)
# IMPORTANT: never reuse the same prefix across environments on a shared account
CLOUDINARY_ENV_PREFIX=dev
