# ─── Database ──────────────────────────────────────────────────────────────────
# NOTE: Start scripts set NODE_OPTIONS=--dns-result-order=ipv4first to force IPv4
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safecrib_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/safecrib_dev?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Mail (Gmail SMTP for transactional emails) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safecrib.app

# ─── App ────────────────────────────────────────────────────────────────────────
PORT=3001
ENABLE_SWAGGER=true
API_NAME=SafeCrib API
API_DESCRIPTION=SafeCrib Platform API Documentation
API_VERSION=1.0.0

# ─── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL_TESTING=http://localhost:3000
FRONTEND_URL_PRODUCTION=
FRONTEND_URL_SWAGGER=http://localhost:3001

# ─── CORS (optional, comma-separated additional origins) ───────────────────────
CORS_ORIGINS=

# ─── Throttler ──────────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10
