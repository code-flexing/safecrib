# Local frontend development uses the shared development API by default.
NEXT_PUBLIC_API_URL=https://dev-safecribs.onrender.com

# To use a backend running locally, replace the value above with:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Production frontend deployments should set the production API origin.
# NEXT_PUBLIC_API_URL=https://safecrib.onrender.com
